# ==============================================================================
# NurseFlow Enterprise Operations Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values before starting the application:
# cp .env.example .env

# Server Configuration
PORT=5000
NODE_ENV=production
APP_URL=http://localhost:5000

# Authentication & Cryptographic Secrets
AUTH_SECRET=replace-with-cryptographic-256-bit-random-secret-key-in-production
JWT_SECRET=replace-with-cryptographic-256-bit-random-secret-key-in-production

# Database Connection URL
# For local SQLite: file:./data/nurseflow.db
# For production PostgreSQL: postgresql://username:password@hostname:5432/nurseflow?sslmode=require
DATABASE_URL=file:./data/nurseflow.db

# Client API Base URL (leave /api for same-origin proxy or specify full backend URL)
VITE_API_BASE_URL=/api
